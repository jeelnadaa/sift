# Copy to .env and fill in. Never commit .env.
ENV=dev                       # dev | prod
LOG_LEVEL=INFO

# --- Where it runs (see docker-compose.yml header) ---
# Laptop + tunnel: redis,tunnel | Oracle: redis,https | e2-micro: https | native Windows: ignored
COMPOSE_PROFILES=redis,tunnel
QUEUE_BACKEND=redis           # redis | postgres (postgres = no Redis needed; use it for native Windows runs)

# --- How new mail is detected ---
CHANGE_DETECTION=poll         # poll (free, no Pub/Sub) | push (Gmail watch + Pub/Sub, needs a billed GCP project)
POLL_INTERVAL_SECONDS=5          # 5 s = 24 Gmail quota units/min per account (limit 6,000)

# --- Public URL ---
# The OAuth redirect URI is PUBLIC_BASE_URL + /api/v1/accounts/oauth/callback; register it on the OAuth client.
# Laptop without tunnel: http://localhost:8000 (Google allows localhost redirects).
# With Cloudflare Tunnel: https://sift.solarquack.in
PUBLIC_BASE_URL=http://localhost:8000
SIFT_DOMAIN=sift.solarquack.in   # used by Caddy (https profile)
API_BIND=127.0.0.1            # where Compose publishes :8000
TUNNEL_TOKEN=                 # Cloudflare Tunnel token (tunnel profile)

# --- Postgres ---
POSTGRES_USER=sift
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sift
PG_SHARED_BUFFERS=128MB       # 64MB on the 1 GB host
# Only for running the API outside Docker:
DATABASE_URL=postgresql+psycopg://sift:change-me@localhost:5432/sift
REDIS_URL=redis://localhost:6379/0

# --- Secrets ---
# Long random string (openssl rand -hex 32). Signs the OAuth state.
APP_SECRET=
# python -m app.cli gen-key   (comma-separate several keys, newest first, to rotate)
ENCRYPTION_KEYS=
# Long random string; protects /api/v1/dev/* and /api/v1/devices until Phase 1 JWT auth.
ADMIN_TOKEN=

# --- App sign-in ---
JWT_DAYS=30                   # how long the phone app stays signed in
LOGIN_ATTEMPTS=8              # failed sign-ins per email / visitor in 15 minutes
API_DOCS=false                # true shows /docs (keep off when reachable from the internet)
WEB_DIST=                     # built web UI folder; empty = web/dist next to backend/ (Docker: built into the image)

# --- LLM (each user brings their own key in Settings; this only pre-fills the model field) ---
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-3.5-flash-lite

# --- Google OAuth client (Web application) for connecting Gmail accounts ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Cloud Pub/Sub (only for CHANGE_DETECTION=push) ---
GOOGLE_PROJECT_ID=
PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/sift-gmail
PUBSUB_VERIFY=true            # never false in prod
PUBSUB_AUDIENCE=https://sift.solarquack.in/webhooks/gmail
PUBSUB_SERVICE_ACCOUNT=sift-pubsub-push@YOUR_PROJECT.iam.gserviceaccount.com

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=
# Outside Docker: path to the service account JSON. In Docker it is ./secrets/firebase.json.
FIREBASE_CREDENTIALS_FILE=./secrets/firebase.json

# --- Backups ---
BACKUP_KEEP_DAYS=14
BACKUP_RCLONE_REMOTE=         # e.g. gdrive:sift-backups (optional, off-VM copy)

# Sign-ups from the app: open (anyone can create an account, rate-limited) or closed
REGISTRATION=open
